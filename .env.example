POSTGRES_USER=civicsense
POSTGRES_PASSWORD=change_me
POSTGRES_DB=civicsense
POSTGRES_PORT=5432

JWT_SECRET=change_me_too
JWT_EXPIRE_MINUTES=60

UPLOAD_DIR=uploads

TEXT_MODEL_PATH=ml/models/text_classifier.joblib
